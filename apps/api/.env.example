# API
PORT=3000

# Redis (required for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# OpenAI — used for Whisper (transcription) and TTS (narration)
OPENAI_API_KEY=sk-...

# Anthropic — used for chronicle generation
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare R2 — S3-compatible object storage
# Find ACCOUNT_ID in the R2 dashboard overview
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=chronicler-dev
