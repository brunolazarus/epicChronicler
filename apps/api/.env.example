# API
PORT=3000

# Redis (required for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# OpenAI — only needed if switching back to OpenAI TTS provider
# OPENAI_API_KEY=sk-...

# ElevenLabs — used for TTS (narration), free tier: 10K chars/month
# Get your key at elevenlabs.io
ELEVENLABS_API_KEY=

# Groq — used for transcription (Whisper via free tier)
# Get your key at console.groq.com
GROQ_API_KEY=gsk_...

# OpenRouter — used for chronicle generation (LLM via OpenAI-compatible API)
OPENROUTER_API_KEY=sk-or-...

# Cloudflare R2 — S3-compatible object storage
# Find ACCOUNT_ID in the R2 dashboard overview
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=chronicler-dev
