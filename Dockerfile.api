FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@9.9.0 --activate

# ── deps: install all workspace dependencies ──────────────────────────────────
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/core/package.json ./packages/core/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY scripts/package.json ./scripts/
RUN pnpm install --frozen-lockfile

# ── build: compile @chronicler/core ───────────────────────────────────────────
FROM base AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY . .
RUN pnpm --filter @chronicler/core build

# ── runner ────────────────────────────────────────────────────────────────────
FROM base AS runner
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY --from=build /app/packages/core ./packages/core
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/apps/worker ./apps/worker
COPY --from=deps /app/node_modules ./node_modules

EXPOSE 3000

# API and worker run together — API serves HTTP, worker processes BullMQ jobs
CMD ["sh", "-c", "pnpm --filter api exec tsx src/index.ts & pnpm --filter worker exec tsx src/index.ts & wait"]
